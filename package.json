{
  "name": "dew-flow-conventions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/low-priority.mjs node --test --test-concurrency=8",
    "check": "node tools/rules.mjs check --repo .",
    "test:coverage": "node tools/low-priority.mjs node --test --test-concurrency=8 --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info"
  },
  "dependencies": {
    "picomatch": "4.0.7",
    "yaml": "2.9.0"
  }
}
